generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model blogs {
  id         Int           @id @default(autoincrement())
  title      String        @db.VarChar(255)
  excerpt    String        @db.Text
  content    String        @db.Text
  image_url  String        @db.VarChar(500)
  author     String        @db.VarChar(100)
  status     blogs_status? @default(draft)
  created_at DateTime?     @default(now()) @db.Timestamp(0)
  updated_at DateTime?     @default(now()) @db.Timestamp(0)
}

model forum_categories {
  id          Int           @id @default(autoincrement())
  name        String        @db.VarChar(100)
  description String        @db.Text
  icon        String        @default("fas fa-comments") @db.VarChar(50)
  color       String        @default("#CE6723") @db.VarChar(7)
  sort_order  Int?          @default(0)
  is_active   Boolean?      @default(true)
  created_at  DateTime?     @default(now()) @db.Timestamp(0)
  updated_at  DateTime?     @default(now()) @db.Timestamp(0)
  forum_posts forum_posts[]
}

model forum_posts {
  id               Int                 @id @default(autoincrement())
  title            String              @db.VarChar(255)
  content          String              @db.Text
  excerpt          String              @db.VarChar(500)
  author           String              @db.VarChar(100)
  category_id      Int
  icon             String              @default("fas fa-comments") @db.VarChar(50)
  replies          Int?                @default(0)
  views            Int?                @default(0)
  status           forum_posts_status? @default(active)
  created_at       DateTime?           @default(now()) @db.Timestamp(0)
  updated_at       DateTime?           @default(now()) @db.Timestamp(0)
  forum_categories forum_categories    @relation(fields: [category_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "forum_posts_ibfk_1")
  forum_replies    forum_replies[]

  @@index([category_id], map: "category_id")
}

model forum_replies {
  id          Int                   @id @default(autoincrement())
  post_id     Int
  author      String                @db.VarChar(100)
  content     String                @db.Text
  status      forum_replies_status? @default(active)
  created_at  DateTime?             @default(now()) @db.Timestamp(0)
  updated_at  DateTime?             @default(now()) @db.Timestamp(0)
  forum_posts forum_posts           @relation(fields: [post_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "forum_replies_ibfk_1")

  @@index([post_id], map: "post_id")
}

model orders {
  id                 Int       @id @default(autoincrement()) @db.UnsignedInt
  price              Decimal   @db.Decimal(10, 2)
  model              String    @db.VarChar(100)
  color              String    @db.VarChar(100)
  product_name       String    @db.VarChar(255)
  trackId            String    @db.VarChar(100)
  orderId            String    @db.Text
  productDescription String    @db.Text
  transaction_id     String    @db.Text
  amount             String    @db.Text
  statid             String?   @db.Text
  payment_status     String    @default("order_not_completed") @db.VarChar(50)
  name               String    @db.VarChar(100)
  lastName           String?   @db.VarChar(100)
  mobile             String    @db.VarChar(15)
  email              String    @db.VarChar(255)
  address            String?   @db.Text
  country            String?   @db.VarChar(100)
  pincode            String?   @db.VarChar(20)
  state              String?   @db.VarChar(100)
  city               String?   @db.VarChar(100)
  source             String?   @db.VarChar(100)
  referralCode       String?   @db.VarChar(100)
  terms              Boolean?  @default(false)
  created_at         DateTime? @default(now()) @db.Timestamp(0)
}

model settings {
  id            Int       @id @default(autoincrement())
  setting_key   String    @unique(map: "setting_key") @db.VarChar(100)
  setting_value String?   @db.Text
  description   String?   @db.VarChar(255)
  created_at    DateTime? @default(now()) @db.Timestamp(0)
  updated_at    DateTime? @default(now()) @db.Timestamp(0)
}

model users {
  id            Int       @id @default(autoincrement())
  name          String
  email         String    @unique(map: "email")
  password_hash String    @db.VarChar(255)
  created_at    DateTime? @default(now()) @db.Timestamp(0)
}

enum forum_replies_status {
  active
  deleted
  moderated
}

enum blogs_status {
  draft
  published
}

enum forum_posts_status {
  active
  locked
  pinned
}
