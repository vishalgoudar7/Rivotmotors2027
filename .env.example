DATABASE_URL="mysql://root:@127.0.0.1:3306/rivot_booking"
DB_HOST="127.0.0.1"
DB_PORT="3306"
DB_NAME="rivot_booking"
DB_USER="root"
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="admin123"
ADMIN_SESSION_SECRET="change-this-local-admin-secret"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
BOOKING_AMOUNT_RUPEES="YOUR_BOOKING_AMOUNT_IN_RUPEES"

# Zaakpay environment: "staging" or "production"
ZAAKPAY_ENV="staging"

# Use test credentials for staging. Never commit real credentials.
ZAAKPAY_MERCHANT_IDENTIFIER="YOUR_TEST_MERCHANT_IDENTIFIER"
ZAAKPAY_SECRET="YOUR_TEST_SECRET"
ZAAKPAY_PAYMENT_URL="https://zaakstaging.zaakpay.com/api/paymentTransact/V13"
ZAAKPAY_STATUS_URL="https://zaakstaging.zaakpay.com/api/payments/v1/status"
ZAAKPAY_RETURN_URL="http://localhost:3000/api/booking/callback"
# Temporary staging-only callback checksum diagnostics. Disable after testing.
ZAAKPAY_DEBUG_CHECKSUM="false"
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=change@rivotmotors.com
SMTP_PASSWORD=
SMTP_FROM=change@rivotmotors.com
SMTP_FROM_NAME="RIVOT Motors"
ADMIN_EMAIL=
